{
  "name": "ws_task",
  "version": "1.0.0",
  "description": "Template for the WebSocket remote control task",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node ./index.js",
    "start:dev": "nodemon ./index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint src --ext .ts",
    "build": "tsc",
    "start:env": "cross-env NODE_ENV=development tsx src/index.ts",
    "dev": "nodemon --watch src --exec tsx src/server.ts"
  },
  "author": "ASDQSA",
  "keywords": [],
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "nodemon": "^2.0.16",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "ws": "^8.8.0"
  }
}
